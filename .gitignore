# ============================================
# STRIX — Expo / React Native .gitignore
# ============================================

# ---------- Dependencies ----------
node_modules/
*.gguf

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn-install-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# ---------- Environment / secrets ----------
# Never commit API keys or local env files.
.env
.env.*
!.env.example
*.pem
*.crt
*.key
*.p12
*.jks
*.keystore
*.p8
*.mobileprovision

# ---------- Expo ----------
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
*.orig.*
web-report/

# ---------- Metro bundler ----------
.metro-health-debug*

# ---------- Native builds (only appear if you prebuild / eject) ----------
# Full folders are generated — standard practice is to ignore them and
# rely on `npx expo prebuild` / the Expo config to regenerate.
android/
ios/

# ---------- EAS / builds ----------
*.apk
*.aab
*.ipa
*.app

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Testing / coverage ----------
coverage/

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
nbproject/

# ---------- OS junk ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
